# Zoho Books API (India data centre). Create a "Server-based Application" at https://api-console.zoho.in
# Scopes: ZohoBooks.invoices.READ,ZohoBooks.salesorders.READ,ZohoBooks.estimates.READ,ZohoBooks.contacts.READ,ZohoBooks.settings.READ
# Copy this file to .env.local and fill in the values. Leave blank to run on sample data.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=60016330017
ZOHO_API_BASE=https://www.zohoapis.in/books/v3
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in

# Shared team storage (optional). MongoDB Atlas free tier works: https://www.mongodb.com/cloud/atlas
# Leave blank to keep calendar entries and follow-ups in each browser only.
MONGODB_URI=
MONGODB_DB=thinkhealth_dashboard
